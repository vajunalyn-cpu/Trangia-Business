# Copy to .env.local for local development, and add the same keys in Vercel →
# Project → Settings → Environment Variables. Never commit real values.

# Public production URL, used for canonical links, sitemap and Open Graph tags.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Endpoint that receives inquiry-form submissions as a JSON POST.
# Works with form services such as Formspree, Basin or Web3Forms, or a CRM / Make / Zapier webhook.
# Leave empty and the form shows an "isn't connected yet" message instead of sending.
NEXT_PUBLIC_INQUIRY_ENDPOINT=
